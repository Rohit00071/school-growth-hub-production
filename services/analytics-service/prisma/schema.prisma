generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["analytics_service"]
}

model Metric {
  id        String   @id @default(uuid())
  name      String   // e.g., 'user_login', 'observation_completed'
  value     Float
  userId    String?
  campusId  String?
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([name])
  @@index([timestamp])
  @@schema("analytics_service")
}

model Report {
  id        String   @id @default(uuid())
  title     String
  type      String   // e.g., 'MONTHLY_SUMMARY'
  data      Json
  createdAt DateTime @default(now())

  @@schema("analytics_service")
}
